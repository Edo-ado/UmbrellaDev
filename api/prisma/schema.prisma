/**
 * Base de datos
 * Para actualizarla sin problemas cada que se ahce un cambio debe colocar el comando npx prisma generate y
 * npx prisma migrate dev --name  'nombre de migracion'
 */

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Enums
enum Role {
  ADMIN
  USUARIO
  DESARROLLADOR
}

enum MODALIDAD {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
  NOCAP
}

enum ESTADOCITA {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  CANCELADA
  COMPLETA
}

enum Estado {
  ACTIVO
  INACTIVO
  BANEADO
}

// Enums

// Models
model Usuario {
  Id Int @id @default(autoincrement())

  // Campos base (todos los usuarios)
  NombreCompleto String  @db.VarChar(150)
  Email          String  @unique @db.VarChar(150)
  Contrasena     String  @db.VarChar(150)
  Pais           String  @db.VarChar(100)
  Edad           Int?
  Telefono       String? @db.VarChar(20)

  // Enums
  Role      Role       @default(USUARIO)
  Estado    Estado     @default(ACTIVO)
  Modalidad MODALIDAD? @default(NOCAP)

  // Campos exclusivos de profesional 
  Descripcion       String?  @db.VarChar(500)
  AnosExperiencia   Int?
  Ubicacion         String?  @db.VarChar(150)
  TituloProfesional String?  @db.VarChar(150)
  TarifaBase        Float?
  Disponibilidad    Boolean?
  Universidad       String?  @db.VarChar(150)
  Foto              String?  @db.VarChar(500)

  // logins
  LastLogin DateTime @default(now())
  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt

  // Relaciones
  citasComoCliente     Cita[]            @relation("CitaCliente")
  citasComoProfesional Cita[]            @relation("CitaProfesional")
  servicios            Servicio[]
  especialidades       Especialidad[]
  imagenesUsuario      ImagenesUsuario[]
  curriculum           Curriculum[]

  resenas            Resena[] @relation("ResenaCliente")
  resenasProfesional Resena[] @relation("ResenaProfesional")
}

model Categoria {
  Id          Int     @id @default(autoincrement())
  Nombre      String  @unique @db.VarChar(150)
  Descripcion String? @db.VarChar(500)
  Estado      Estado  @default(ACTIVO)

  especialidad Especialidad[]
  servicio     Servicio[]
}

model Especialidad {
  Id          Int     @id @default(autoincrement())
  Nombre      String  @unique @db.VarChar(150)
  Descripcion String? @db.VarChar(500)
  Estado      Estado  @default(ACTIVO)

  CategoriaId       Int
  CategoriaAsociada Categoria @relation(fields: [CategoriaId], references: [Id])

  serviciosEspecialidad   Servicio[]
  profesionalEspecialidad Usuario[]
}

model Servicio {
  Id          Int       @id @default(autoincrement())
  Nombre      String    @db.VarChar(150)
  Descripcion String?   @db.VarChar(500)
  Precio      Float
  Duracion    Int?
  Estado      Estado    @default(ACTIVO)
  Modalidad   MODALIDAD @default(PRESENCIAL)

  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt

  idprofesional Int
  profesional   Usuario @relation(fields: [idprofesional], references: [Id])

  idcategoria Int
  categoria   Categoria @relation(fields: [idcategoria], references: [Id])

  servicioEspecialidades Especialidad[]

  citas             Cita[]
  imagenesServicios ImagenesServicio[]
}

model Cita {
  Id Int @id @default(autoincrement())

  fechaHora DateTime

  Fecha       DateTime
  Hora        String   @db.VarChar(10)
  TiempoTotal Int
  HoraFin     String   @db.VarChar(10)

  Monto Float

  MotivoCancelacion String? @db.VarChar(500)
  MotivoRechazo     String? @db.VarChar(500)

  Modalidad   MODALIDAD  @default(PRESENCIAL)
  Descripcion String?    @db.VarChar(500)
  Comentarios String?    @db.VarChar(500)
  Estado      ESTADOCITA @default(PENDIENTE)

  CreatedAt DateTime @default(now())
  UpdatedAt DateTime @default(now()) @updatedAt

  idcliente Int
  cliente   Usuario @relation("CitaCliente", fields: [idcliente], references: [Id])

  idprofesional Int
  profesional   Usuario @relation("CitaProfesional", fields: [idprofesional], references: [Id])

  idservicio Int
  servicio   Servicio @relation(fields: [idservicio], references: [Id])

  resenas Resena[]

  historialEstadoCitas HistorialEstadoCita[]
}

model HistorialEstadoCita {
  Id             Int        @id @default(autoincrement())
  EstadoAnterior ESTADOCITA
  EstadoNuevo    ESTADOCITA
  Motivo         String?    @db.VarChar(500)
  Fecha          DateTime   @default(now())

  citaId Int
  cita   Cita @relation(fields: [citaId], references: [Id])
}

model Resena {
  Id         Int      @id @default(autoincrement())
  Puntuacion Int
  Comentario String?  @db.VarChar(500)
  CreatedAt  DateTime @default(now())

  citaId Int  @unique
  cita   Cita @relation(fields: [citaId], references: [Id])

  clienteId Int
  cliente   Usuario @relation("ResenaCliente", fields: [clienteId], references: [Id])

  profesionalId Int
  profesional   Usuario    @relation("ResenaProfesional", fields: [profesionalId], references: [Id])


  imagenes      Imagenes[]
  @@index([profesionalId])
  @@index([clienteId])
}

model Imagenes {
  Id     Int     @id @default(autoincrement())
  Nombre String? @default("NoName")
  Url    String  @default("NoImage.url") @db.VarChar(500)

  imagenesUsuario   ImagenesUsuario[]
  imagenesServicios ImagenesServicio[]

  resena   Resena? @relation(fields: [resenaId], references: [Id])
  resenaId Int?
}

model Curriculum {
  Id  Int    @id @default(autoincrement())
  Url String @db.VarChar(500)

  UsuarioID Int
  Usuario   Usuario @relation(fields: [UsuarioID], references: [Id])
}

model ImagenesUsuario {
  CreatedAt DateTime @default(now())

  idImagen Int
  imagen   Imagenes @relation(fields: [idImagen], references: [Id])

  idUsuario Int
  usuario   Usuario @relation(fields: [idUsuario], references: [Id])

  @@id([idImagen, idUsuario])
}

model ImagenesServicio {
  CreatedAt DateTime @default(now())

  idImagen Int
  imagen   Imagenes @relation(fields: [idImagen], references: [Id])

  idServicio Int
  servicio   Servicio @relation(fields: [idServicio], references: [Id])

  @@id([idImagen, idServicio])
}

// Models
